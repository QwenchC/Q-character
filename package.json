{
  "name": "q-character-studio",
  "version": "0.11.0",
  "private": true,
  "description": "面向超轻黏土创作的 Q 版角色设计与 3D 工作台",
  "author": "Lumi",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --win portable --x64",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "vision:install": "node scripts/install-vision-node.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.lumi.qcharacter",
    "productName": "Q Character Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "examples/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Q-Character-Studio-${version}-Windows.exe"
    }
  }
}
